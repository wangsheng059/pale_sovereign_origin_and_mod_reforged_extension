local S = ::PaleSovereign;

// 1.6.21 文字加长，整段 180–250 字。1.6.20 常驻亡灵的背景说明：生前身世（按种族各 15 段，抽一次后存进旗标，升阶也不变）
// + 形态（每个背景各 5 段）+ 营中见闻（按种族各 10 段）。每个背景至少 15 种完全不同的身世，组合共 750 种。
S.UndeadLore <- {
    Origins = {
        zombie = [
            "饥荒那年，它在磨坊里替人扛麦袋，欠下的债越滚越多，最后被债主吊死在磨坊的横梁上。脖子上那道发黑的勒痕至今没有褪去，缝合的人只好用一圈粗麻布把它裹住，免得吓着营地里的活人。",
            "它生前是村里的民兵，守着一道木栅栏和一把生锈的草叉。强盗来的那一夜，它是最后一个倒下的，身上的刀口多得连缝尸人都懒得一道道去数，只好整片整片地缝。",
            "矿道塌方时，它被埋在碎石底下整整三天，没有人来挖。等到被挖出来的时候，它的指甲全掀翻了，手心里还死死攥着一块没来得及交上去的银矿石，掰都掰不开。",
            "它做了半辈子走私的买卖，最后一趟夜里渡河时被巡逻的弩手射落水中。尸体在芦苇荡里泡了一个春天才被人捞起，至今摸上去还带着一股河泥的凉意，怎么腌也腌不掉。",
            "瘟疫年里，它是镇上替人抬尸的屠夫学徒，一车一车地往石灰坑里送，从早到晚不得歇息。等到它自己也发着高烧倒在车辕旁的时候，镇上已经没有一个活人肯来抬它了。",
            "它是个老实的佃农，在一个大雪封路的冬天冻死在去集市的半道上。被人发现时，它冻僵的手里还紧紧攥着几枚铜币，那是给家里生病的孩子买药的钱，一枚也没舍得花。",
            "它曾在一支早已解散的战团里吃饭，替人卖了好几年的命。战团长拖欠了三个月军饷，它带头去讨，当晚的炖菜里就多了一把毒蘑菇，第二天早上再也没能爬起来。",
            "它生前是个靠海吃饭的渔夫，一场突来的风暴掀翻了渔船。被海浪冲上岸时，它浑身泡得发白，腰上还缠着半截断掉的渔网，缝尸人花了一整晚才把它们从皮肉里剔干净。",
            "它在铁匠铺里抡了二十年大锤，一次熔炉炸裂烫伤了半边身子，高烧七天后咽了气。如今它半边脸上还留着发亮的烫疤，那条抡锤的右臂也依旧比左臂粗壮结实得多。",
            "它是个徒步赶路的朝圣者，死在离圣地还有三天路程的驿道旁。一位路过的修士替它合上了眼，草草埋在路边，谁也没有想到，这座浅浅的土坟有一天会被人重新挖开。",
            "它当过逃兵，被抓回去后吊在十字路口示众了整整七天，好让过路的新兵都看个清楚。乌鸦啄走了它的一只眼睛，缝尸人只好往那只空洞里塞了一团浸过盐水的麻絮，再用黑线缝上。",
            "它生前也干过盗墓的营生，某个雨夜被分赃不均的同伙一铲子拍进了刚挖开的墓坑，连同那口没撬开的棺材一起埋了。说来讽刺，如今它又被同一种人从土里挖了出来。",
            "它是个伐木工，在林子里砍了一辈子的树，最后那棵老橡树却朝错误的方向倒了下来。它的胸口至今凹下去一大块，缝合的黑线在那里来回绕了好几圈，才勉强把断掉的肋骨固定住。",
            "它在南方的角斗场里流过血，替看台上的老爷们赢过不少赌注，也挨过无数次鞭子。最后一场比试它输给了一头北方来的熊，被铁钩拖出沙地时，连名字都没有一个人记下。",
            "它曾举着火把，替一位猎巫人走遍各地追捕亡灵法师，烧过不少坟、也烧过不少人。在一场围剿里，它被自己追捕的人诅咒而死，如今却成了被缝合、被驱使的那一个。"
        ],
        skeleton = [
            "这副骨架曾属于古帝国的一名军团辅兵，常年戍守北方那道早已倾颓的长墙。它的肩骨和前臂上留着被重盾磨出的凹痕，那是几十年风雪里站岗留下的记号，至今清晰可辨。",
            "它生前是修建陵墓的工匠，墓室竣工的那一天，和其他工匠一起被封死在了里面，好让墓道的秘密永远无人知晓。它的指骨末端磨得很短，像是在石门上抓挠了很久很久。",
            "它是帝国的一名传令兵，带着一封早已无人记得内容的急信穿越南方荒漠，最终被沙暴吞没。它的骨头被风沙打磨得光滑发亮，几乎看不出曾经包裹过血肉的痕迹，摸上去像一截温润的玉。",
            "这具枯骨来自帝国鼎盛时的竞技场，曾在万人的欢呼声里搏杀过野兽与囚徒。它的肋骨上有三处愈合又断裂的痕迹，看来它在沙地上活下来的次数，远比死去的那一次多。",
            "它曾是宫廷卫士，奉命守护一位早夭王子的棺椁，直到自己也老死在幽暗的墓道里，再也没有人来换岗。如今它依然习惯站在门口，仿佛还在等候那道迟迟不来的号令。",
            "它是一名被处决的叛军百夫长，颈骨上那道整齐的切口说明了一切。帝国把它的头颅挂在城门上示众了一整年，它的骨头却被忠诚的部下趁夜偷走，偷偷埋进了荒山。",
            "它生前替古老的祭司们抬过棺，一辈子都在给别人送葬，见过的死人比活人还多。也许正因为如此，它对缝合台和防腐药水的刺鼻气味，表现得比别的骷髅都更加温顺。",
            "帝国末年兵源枯竭，它这样的边境农兵被强行征召入伍，没过一个冬天就倒在了第一场战斗里。它那细瘦的手腕骨，看起来从没握过比锄头更重的东西，却依然握紧了兵器。",
            "它在帝国舰队里当过水手，跟着战船走遍了南方的每一座港口。它的骨缝间至今嵌着细小的海盐结晶，每当刮起潮湿的海风，它的关节就会发出比平时更响的咯吱声。",
            "它是戴着镣铐修筑帝国大道的苦役，日复一日地搬运石板，死后就被埋在了自己亲手铺下的路面底下。它的两根脚踝骨上，至今还留着两道被沉重的铁镣磨出来的深沟。",
            "这副骨架是从一处乱葬岗里拼凑出来的，严格说来至少属于两个不同的人：左臂明显比右臂长出一截，头骨也比肩膀窄小。缝合的人只好在肩膀和腰间多缠了几道铜索，才让它勉强站得稳当。",
            "它生前是军团里最年轻的旗手，骨架纤细得像个半大的孩子，却扛着比自己还高的军旗。残存的古籍上说，那支军团全军覆没的那一天，军旗是最后一个倒下的。",
            "它是一名打了三十年仗的老兵，骨头上满是刀砍斧劈后重新愈合的痕迹，几乎找不到一块完好的地方。死神找了它很多次，最终也只是等到它安安静静地老死在了床上。",
            "它下葬时是一位显赫的贵族，周身缀满了金饰与宝石，棺椁四周还摆着成箱的陪葬。盗墓贼早就把这些东西剥得干干净净，只在它的指骨间漏掉了一枚被铜锈染绿的小戒指。",
            "一场瘟疫横扫了它所在的古城，城民被成批地推进石灰坑里，连名字都来不及登记。它的骨头至今带着一层怎么也洗不掉的灰白，敲上去声音发闷，像敲一块干透的石膏。"
        ],
        archer = [
            "这具枯骨曾是古帝国长墙箭楼上的弓手，一辈子都在俯视墙外那片荒凉的原野，等待永远不会停止的蛮族袭扰。它右手的三根指骨磨得发亮，那是千万次扣弦留下的痕迹。",
            "它生前是林子里的猎户，一次追猎时被受伤的野猪顶穿了肚子，在灌木丛里流尽了血。多年以后，伐木人在树根下挖出它的时候，它的手里还握着那张早已朽烂的猎弓。",
            "它曾是个偷猎者，在领主的猎场里射杀了一头雄鹿，被看守当场抓住，吊死在那棵最高的橡树上。它的颈骨至今歪向一边，看人的时候总像是在侧着头瞄准，让被它盯着的人浑身不自在。",
            "它是帝国城门的守卫弩手，据说凭一架重弩就守住过一整个夜晚，射退了三次夜袭。它的左肩骨比右肩厚实得多，那是常年抵住弩托的缘故，缝尸人一摸就摸得出来。",
            "它属于荒原上一支早已消亡的部落，生前靠投掷骨矛猎杀野马和羚羊。缝尸人在它的腕骨上发现了一圈细细的刻痕，每一道大概都代表着一次成功的狩猎，密密麻麻数不过来。",
            "它曾在帝国宫廷里教授射艺，那些王子贵胄都要恭恭敬敬地称它一声老师，连皇帝也来观摩过它的课。即使变成了一副枯骨，它开弓的姿势依然端正得近乎刻板。",
            "它是驿道旁一座瞭望塔的守兵，独自在塔上守了十几年，最后病死在塔顶，直到下一个换岗的人到来才被发现。也许是看惯了远方，它那空洞的眼窝总是习惯性地望向地平线。",
            "它在帝国战船上当过弩手，专射敌船甲板上的舵手和桨手，一场海战能射空三个箭囊。它的骨头上残留着淡淡的海盐，只要一到潮湿的天气，它的弓弦就会松上半分。",
            "它生前是城里的民兵弓手，攻城战时被城头滚落的巨石砸断了腿，在城墙根下躺了三天才咽气。它的左腿骨上至今箍着一圈缝尸人后来加上去的铁片，走起路来一高一低，咯噔作响。",
            "它曾跟着一伙盗墓贼钻进古墓，负责在后面放箭掩护，结果被墓道里的机关弩一箭穿喉，同伙连尸体都没顾得上带走。如今它的喉骨上还留着一个整整齐齐的小洞。",
            "它是南方沙漠里的骑射手，能在飞驰的马背上回身射落追兵，在一次追击中却坠了马，被自己的马拖行了半里地。骨头上有许多细碎的裂纹，都被铜索仔仔细细地箍住了。",
            "它死时还只是个学徒弓手，骨架尚未长成，个头比其他骷髅矮了一截，连弓都比别人短一些。教它射箭的那位严厉的师父，大概也早已埋进了某处无人记得的土坑里，连墓碑都没有立。",
            "它生前是一位技艺出众的女猎手，曾独自追踪狼群穿过整片雪原，带回了七张狼皮。如今它的指骨依旧灵巧，搭箭的速度比营地里许多活人弓手都快，连猎户都自叹不如。",
            "它在一伙拦路强盗里当射手，专射商队领头的那匹马，好让整支车队停下来。后来强盗团被领主的骑兵剿灭，它和同伙们一起被吊死在了大路边上，晾了整整一个秋天。",
            "它是一名受雇的弩手，死在一场早已无人记得起因的边境战争里，拿到手的军饷还不够买一口棺材。那场仗打了七年，到头来连两边的领主都忘了当初为什么要开战。"
        ]
    },
    Forms = {
        zombie = [
            "厚重发硬的粗盐痂下，依然保留着生前结实的筋肉。粗糙的黑线勉强缝住了致命的创口，它拖着僵硬的步子，却能死死钉住阵线的缺口。",
            "盐和药草腌透了它的皮肉，让它闻起来像一块放了太久的熏肉。它不懂什么招式，只会举起兵器一下下往前砸，直到对面的人倒下为止。",
            "它的皮肤是一种不健康的灰绿色，被纵横交错的缝合线分割成一块一块。它走得很慢，可一旦站定，就算被长枪捅穿了肚子也不会后退半步。",
            "一层又一层的裹尸布缠住了它身上最难看的伤口，只露出一双浑浊发白的眼睛。它对疼痛毫无反应，挨上一刀，只会迟钝地低头看一眼。",
            "缝尸人在它的关节里塞满了浸过死灵药水的麻絮，让这具躯壳勉强能够弯曲。它挥动兵器的动作笨拙而沉重，却从来不知道疲倦。"
        ],
        skeleton = [
            "几根浸过死灵药水与黑盐的铜索，把这副发黄的枯骨牢牢捆扎在一起。它行军时咔哒作响，眼窝里只跳动着一缕微弱的幽蓝魂火。",
            "它的骨头被墓土染成了暗褐色，每处关节都箍着一圈铜丝。它举盾的姿势标准得像是从古老兵书上拓下来的，一板一眼，从不出错。",
            "这副骨架轻得出奇，仿佛一阵大风就能把它吹散成一地碎骨。可当它端起兵器站进阵线时，却稳得像一根深深打进地里的木桩。",
            "它的下颌骨用一根细铁丝勉强挂着，走路时总会轻轻碰响上排的牙齿。它听不懂活人的语言，却对导师法杖的每一次起落都了如指掌。",
            "它的肋骨间塞着几团盐封的符纸，替那缕魂火挡住寒风。它不需要喘息，也不知道害怕，只会在号令下达时机械地举起兵刃。"
        ],
        skeleton_archer = [
            "指骨扣弦的姿势还和生前一模一样，空洞的眼窝里，那缕魂火替它瞄准。它拉弓时没有呼吸，也就没有一丝颤抖，箭总是射得又平又稳。",
            "它的弓背上缠着一圈褪色的布条，弓弦是导师用浸过盐的筋腱重新绞过的。它开弓时骨节轻响，射出的箭却总能稳稳钉进目标。",
            "它习惯站在队伍的最后面，脑袋微微偏着，像是在侧耳倾听风向。等它终于松开弓弦，那支箭往往已经落在了敌人的喉咙上。",
            "箭囊被它用铜丝牢牢绑在了脊骨上，一伸手便能摸到。它射箭的节奏缓慢而均匀，像一台不知疲倦、永远不会停歇的老旧水车。",
            "缝尸人替它换过两根断掉的指骨，可它扣弦的手法一点也没走样。它在夜里看得比活人更清楚，只是射得没有白天那么准。"
        ],
        grave_guard = [
            "它的鳞甲早已锈成了暗红色，却依然一片不落地挂在骨架上。它总是站在阵线的最前方，用盾牌替身后的同伴挡下每一记重击。",
            "幽绿的魂火在它的护颈后跳动。它生前大概守过某位帝王的陵墓，如今照样寸步不让，剑刃划开的伤口久久不会愈合。",
            "它的盾牌上刻着早已没人认得的军团徽记，被无数次劈砍磨得几乎平了。只要它还站着，就没有人能从它的身边绕过去。",
            "它出剑的动作很短，从不浪费一分力气，每一剑都冲着盔甲的缝隙而去。挨过它一剑的人，伤口里总会渗出一股墓土的腥气。",
            "它的骨头上叠满了新旧两种铜索，那是缝尸人一次次替它加固留下的结果。它站在原地的样子，就像一道会走路的墓门。"
        ],
        tomb_halberdier = [
            "高冠之下，枯骨披着一件褪色的长袍。它习惯站在第二排，越过同伴的肩头递出长戟，一击便能砸散敌人好不容易摆好的架势。",
            "它的长戟比它自己还高出一截，戟刃上缠着一圈发黑的布条。它挥动时的那股分量，能把盾牌后面那条手臂的骨头震得发麻。",
            "它总是和前排保持着整整一臂的距离，从不贪功冒进。敌人刚刚举盾架住前面的骷髅，它的戟刃就已经从侧面重重落了下来。",
            "它的高冠上还插着一根早已褪尽颜色的羽饰，在风里轻轻摇晃。它挥戟的节奏不紧不慢，像在操练场上一样，却从来不会砸偏。",
            "被它的长戟砸中过的人，往往要好一阵子才能重新抬起盾牌。它似乎很清楚该往哪里砸，才能让对方的骨头出现一道裂缝。"
        ],
        bone_blade = [
            "一条褪色的红布束在它的脊骨上，像是某场早已被人遗忘的角斗留下的彩头。它总抢在号角声落下之前出刀，敌人一倒，立刻扑向下一个。",
            "它的身形比其他骷髅更加轻盈，两把短刃在手里转得飞快。它从不在一个敌人身上多停留片刻，砍倒一个就立刻去找下一个。",
            "它的脚步轻得几乎听不见声响，总能在敌人回过神之前贴到身前。刀光一闪，它就已经从倒下的尸体旁边轻轻掠了过去。",
            "它的肩胛骨上刻着一道道浅浅的划痕，据说都是它每次连斩之后自己刻上去的。缝尸人仔细数过，那块骨头已经快刻不下了。",
            "它挥刀时手腕翻转的角度刁钻得出奇，像是在跳一支早已失传的古老剑舞。看台早就塌了，它依然在为看不见的观众表演。"
        ],
        skeleton_king = [
            "王冠下的魂火已经变成了冷蓝色。它还记得自己统领过军团，号令一出，周围的枯骨与行尸便会一同举起武器，向它所指之处压去。",
            "它的王冠早已锈迹斑斑，镶嵌的宝石也被撬走了大半，可它戴着这顶残冠的姿态依旧威严。亡灵站在它身边时，连队列都整齐了几分。",
            "它很少亲自冲锋，总是站在阵中静静地注视着整个战场。只要它抬起枯瘦的手臂，身边的亡灵便会像潮水一样涌向它所指的方向。",
            "它的长袍上用金线绣着一条早已褪色的家族谱系，一直追溯到帝国最古老的年代。它不会说话，但身边的亡灵似乎都听得懂它的沉默。",
            "据说它生前统治过一座如今只剩下地名的城邦。死后数百年，它依然无法忍受任何一具亡灵在它面前站得歪歪斜斜、东倒西歪。"
        ],
        barrow_knight = [
            "黑铁板甲落地时震开了肩上的墓土。它在冲锋中死去，也在冲锋中醒来，盔缝里的魂火一亮，第一个要撞倒的就是挡在最前面的人。",
            "它的板甲上留着一道从左肩一直划到腰间的深痕，那多半就是当年要了它性命的一击。如今它冲锋时总是挺着那一侧，仿佛想再撞一次。",
            "它的步子沉重而缓慢，可一旦开始冲刺，就没有什么能让它停下来。它挥出的第一击总是最重的，往往连盾带人一起砸翻在地。",
            "它的头盔面罩被焊死了，没有人见过面罩后面究竟还剩下什么。只有每次冲锋之前，那道窄窄的缝隙里，魂火会骤然亮上一下。",
            "它的骑枪早已断成了两截，现在它握的是一把同样沉重的长兵。它显然更怀念马背，可即使只剩下双腿，冲锋的气势也一点不减。"
        ],
        tomb_blademaster = [
            "长刀出鞘时，暗红色的火沿着刃口掠过。它生前是一代剑术名家，如今从黑斗篷下踏出一步，敌人往往还来不及拔刀就已倒下。",
            "它的黑斗篷下摆被荆棘撕成了一条一条，风一吹便像一群纠缠的影子。它总是在敌人还没站稳时出手，从不给对方第二次机会。",
            "它握刀的手法和任何一本剑谱都对不上，那是它活着时自己琢磨出来的路数。被它盯上的人，通常连它从哪里出刀都没有看清。",
            "它出刀前会微微低头，像是在向对手郑重致意。可那份礼节只持续一眨眼的工夫，下一刻，刀锋就已经落在了对方的颈侧。",
            "它的刀鞘上挂着一串小小的骨片，据说每一片都来自一位败在它手下的剑客。缝尸人不太确定，这串骨片究竟还会不会继续变长。"
        ],
        bloated_corpse = [
            "发青的腹部把缝线撑得紧绷，被砍开的腐肉还会蠕动着重新合拢。围住它的人要当心，它倒下的那一刻，满腹的腐毒会一齐炸开。",
            "它的肚子胀得像一只灌满了水的皮囊，走起路来左摇右晃。可越是挨刀，它身上的腐肉就合拢得越快，仿佛那些伤口根本不存在。",
            "它每走一步，身上的缝线都会发出一阵令人不安的绷紧声。活人兄弟们都很默契地离它远远的，谁也不想站在它倒下的地方。",
            "它的皮肤薄得几乎透明，能隐约看见底下翻涌着的暗绿色腐液。缝尸人每次替它补线都戴着两层手套，补完还要洗上半天的手。",
            "它身上的气味让苍蝇都不敢靠近。它从不躲闪，任由刀剑一下下落在身上，反正那些伤口用不了多久，就会自己重新长好。"
        ],
        fallen_hero = [
            "一张半腐的脸藏在一顶凹陷的旧骑士盔下。支撑它作战的黑线随着伤口一道道绷紧，伤得越重，它反倒越难被彻底打倒在地。",
            "它的胸甲上还能看出某个骑士家族的纹章，只是早已被锈迹和血污糊成了一团。它挥剑的动作里，仍残留着一丝生前的骄傲。",
            "它的盔甲沉得连活人都穿不动，可它从来不喊累。每当残躯被砍得摇摇欲坠，那些缝线就会绷得更紧，把它重新拽回原位。",
            "据说它生前是一位战死沙场的骑士，死后被葬进了家族的墓地。如今它站在活人兄弟身边作战，它的家族大概做梦也想不到。",
            "它的一条胳膊几乎被砍断，只靠三道粗黑线挂着，可握剑的那只手依然稳如磐石。它不在乎伤口，只在乎面前还剩下几个敌人。"
        ],
        frenzied_corpse = [
            "额前的缝线还在不停地渗血，根本来不及打结。它一闻到活人的气味就会扑上去，身上越是血肉模糊，挥砍起来就越是凶狠。",
            "它的眼睛里总是布满血丝，即使身为死人也是如此。它从不排队，也从不等待号令，只要看见敌人，就会嘶吼着冲上去。",
            "它的牙关咬得死紧，下颌上的缝线早已被它自己崩断了好几次。流出的血越多，它的动作反倒越快，像是被什么东西激怒了。",
            "缝尸人在它身上用的线比别人多出一倍，因为它总是带着一身新伤回来。可没有人能劝得住它，它根本不知道什么叫作后退。",
            "它在营地里安静得出奇，只有在闻到血腥味时才会突然站起来。活人兄弟们宰杀牲口的时候，总要先把它拴得牢牢实实的。"
        ],
        dread_corpse_lord = [
            "它的身躯比任何活人都高出一头，腐肉下的骨骼被铁箍层层加固。它抬脚践踏时，脚下的盾牌和骨头会一起碎成一片。",
            "它的每一步都会在泥地里留下一个深深的脚印，连战马见了都要惊得后退。它从不急于挥动兵器，而是先抬起那只沉重的脚。",
            "它的双腿被缝尸人用铁条重新加固过，粗得像两根石柱。被它踩中的人，就算侥幸活了下来，也要躺上好几天才能起身。",
            "它的胸口烙着一个早已辨认不出的徽记，或许它生前也曾是某一方称霸的豪强。如今，它把那份蛮横与暴躁全都用在了脚底下。",
            "它站在阵中的时候，周围的敌人都会不由自主地往后缩上一缩。谁也不想成为下一个被它一脚踩进烂泥里、连骨头都捡不起来的倒霉鬼。"
        ],
        corpse_colossus = [
            "它由好几具尸体缝合而成，背上的几只手仍在无意识地抓握。它散发的腐臭让贴近的敌人头晕目眩，先耗尽力气的总是活人。",
            "它的身上能数出至少三种不同肤色的皮肉，被粗黑线拼成一座摇摇晃晃的肉山。它很少主动出击，只是站着，等敌人自己喘不过气。",
            "缝尸人为了拼出这具躯壳，整整用掉了一车尸骸。它的个头大得连帐篷都塞不进去，只能常年站在营地外头，任凭风吹雨淋。",
            "它的胸腹间嵌着好几张模糊的面孔，偶尔还会张开嘴无声地开合。贴着它作战的敌人，没过多久就会脸色发青、两腿发软。",
            "它的身躯厚重得出奇，刀剑砍进去就像砍进一块湿透的泥地。等到对面的人砍得手臂发酸，它才慢慢抬起手里的兵器。"
        ],
        carnage_fiend = [
            "它的指骨被拉长成了钩爪，瘦长的身躯总是伏在地上。它会突然越过挡路的人，扑到真正的猎物身旁，把对方撕得鲜血淋漓。",
            "它弓着背行走，四肢着地时比两脚站立时快得多。它的目光从不停留在前排的盾牌上，总是越过人群，去找藏在后面的那一个。",
            "它的指甲被缝尸人换成了磨尖的铁钩，每一次挥动都会带出一串血珠。它扑击的速度快得惊人，连弓手都来不及搭第二支箭。",
            "它在营地里总是蜷缩在阴影里，一动不动，像一具被遗忘的尸体。可一旦战斗开始，它就会在眨眼之间出现在敌人的身后。",
            "它的嘴角被缝线一直拉到了耳根，看上去永远在咧嘴狞笑。被它扑倒的人，往往还没来得及惨叫，就已经被撕开了喉咙。"
        ],
        crypt_longbow = [
            "这具枯骨曾在空无一人的幽暗墓道里一遍遍练习开弓。如今它能把一支箭送过两座坟丘，再稳稳钉进一面挂在树上的旧盾。",
            "它的长弓比它自己还高，弓身是用古墓里的紫杉木重新削成的。它开弓时整副骨架都会绷紧，箭矢离弦的声音像一声低沉的叹息。",
            "它射出的箭能轻易穿透轻甲，箭头上还缠着一缕浸过盐水的黑布。被它盯上的人，就算躲在盾牌后面，也未必能保住性命。",
            "它总是站在离战线最远的地方，静静地等待最好的时机。等它终于松开弓弦，那支箭往往已经越过了大半个战场的距离。",
            "它的弓弦是导师用三股筋腱拧成的，只有它那副骨架才拉得满。活人弓手试过一次，第二天手臂就肿得抬不起来，再也不敢碰。"
        ],
        tomb_arbalest = [
            "它把弩托抵进肩窝，颌骨在弩弦松开以前一动不动。它生前想必守过一段漫长的城墙，最懂得如何耐心地等待猎物走进射程。",
            "它的重弩被铆钉和铜片层层加固，绞盘转动时发出沉重的咔嗒声。它从不轻易移动，一旦找好位置，就像在那里生了根一样。",
            "它上弦的动作缓慢而精确，每一圈绞盘都转得分毫不差，从不慌乱。只要它站定不动，那一记沉重的弩矢就很少会落空。",
            "它的肩骨上垫着一块磨得发亮的皮革，那是常年抵住弩托留下的痕迹。它射出的弩矢，能把一名重甲武士直接钉在地上。",
            "它总是蹲在掩体后面，只露出半个头骨和一截乌黑的弩身。敌人往往直到被射中，才惊觉那里竟然藏着一架上好弦的重弩。"
        ],
        barrow_skirmisher = [
            "一根根细骨被削成了锋利的矛尖，用麻绳捆成一束背在身后。每当第一支矛离手，下一支就已经稳稳落进了它的指骨之间。",
            "它的背上捆着满满一束削尖的骨矛，走起路来哗啦作响。它投矛的动作又快又狠，像是生前在荒原上追猎过无数奔逃的野兽。",
            "它习惯在战线的侧翼来回游走，寻找那些露出破绽的敌人。一支骨矛呼啸着飞过去，对方的盾牌上往往就会多出一个窟窿。",
            "它的投掷手臂比另一只手臂粗壮得多，缝尸人特意多箍了两道铜索。它掷出的第一支矛从来不用心疼，因为第二支已经在手里了。",
            "它削骨矛的手艺好得出奇，营地里的边角骨料到了它手里，转眼就成了一束锋利的投矛。活人兄弟们都很好奇它是跟谁学的。"
        ],
        death_omen = [
            "夜色和距离都遮不住它眼窝里那点幽冷的火光。导师的诅咒一旦攀上某个敌人，那支早已搭在弦上的箭，便终于有了落点。",
            "它的头骨上蒙着一块黑布，只露出一只燃着冷光的眼窝。它射出的箭总是落在最虚弱的人身上，像是早已嗅到了死亡的气味。",
            "据说被它瞄准过的人，都会在前一夜梦见一只白骨乌鸦在窗外不停地啼叫。它很少空射，每一箭都冲着头颅而去，从不留情。",
            "它站在远处，一动不动，像一块冰冷的墓碑。直到导师的诅咒落在敌人身上，它才缓缓举起弓，仿佛终于等到了一个确定的答案。",
            "它的箭羽是用乌鸦的羽毛做的，飞过时几乎听不见声响。被它射中的人，往往直到倒下都没有看清箭究竟是从哪里来的。"
        ],
        nether_bombardier = [
            "它熟悉重弩绞盘的每一个齿，也知道火炮后坐时该把肩膀抵在哪里。被它击中的人，总要多花上片刻才能重新站稳脚跟。",
            "它的护颈是一整块冷铁锻成的，上面布满了铆钉。它射出的弩矢能把板甲砸得深深凹陷，连带着里面的人一起踉跄后退。",
            "它身上总带着一股硝石和铁锈混合的呛人气味，隔着半个营地都闻得到。它不在乎射中了哪里，只要能把敌阵砸出缺口就行。",
            "它的武器沉得需要两个活人才能抬动，它却独自扛着走了整整一路。每次击发之后，它都会默默地数着绞盘转过的圈数。",
            "被它击中过的盔甲，营地里的铁匠都说没法再修了，只能回炉。它似乎专门挑那些穿着最厚护甲的敌人下手，从不手软。"
        ],
        arrow_rain_weaver = [
            "它那空洞的眼窝顺着一条看不见的弧线缓缓抬起。箭矢和短矛随即从高处落下，把一小片阵地织得密不透风，无处可躲。",
            "它的身上缠满了破碎的白布条，在风里飘动时像一群幽灵。它很少直射，总是把箭抛向高空，让它们像雨点一样落下来。",
            "它射箭的节奏有一种奇怪的韵律，仿佛在一针一线地编织一张看不见的网。等到最后一支箭落地，那片阵地上已经没有人还站着。",
            "它总是先抬头看一眼天空，再细细估算风向和距离。它的箭雨从不落在自己人头上，这让活人兄弟们既敬畏，又暗自庆幸。",
            "它背着两个箭囊和一束短矛，每场仗都能把它们打得一干二净。缝尸人抱怨说，它大概是整个营地里最费箭的一个家伙。"
        ]
    },
    Camp = {
        zombie = [
            "干结的粗盐颗粒随着步伐从 %name% 的衣缝间簌簌滑落。营地里的活人总在抱怨它身上挥之不去的咸腥味，但你很清楚它的价值：它不吃不喝，不讨薪水，更不会临阵脱逃。",
            "每当夜幕降临，营地里的活人兄弟总会下意识地离 %name% 远远的，生怕它那双空洞的眼睛突然转向自己。可只要号角一响，所有人都得承认，这个死人比佣兵更守规矩。",
            "%name% 是从一口洒满粗盐的旧木棺里缓缓坐起来的。它早已记不清自己的名姓和家乡，可当冰冷的兵刃被塞进手里时，那副躯壳里的本能便立刻苏醒了过来。",
            "对 %name% 来说，死亡并没有带来安息，不过是换了一个更冷酷、也更慷慨的雇主罢了。它在你的缝合台上重新睁开了浑浊的双眼，从此再也没有闭上过。",
            "伙夫每天都要绕着 %name% 走，因为它总喜欢站在锅边，盯着翻滚的肉汤一动不动。没有人知道它是在回忆生前的味道，还是忘了自己早已不需要吃饭。",
            "盗墓贼们在 %name% 身上打过赌，看谁能先让它眨一下眼睛。他们扮鬼脸、吹口哨、往它脸上弹泥巴，到现在赌注已经涨到了三十克朗，还没有一个人赢过。",
            "%name% 每次挨刀之后，都会默默走到缝尸人跟前，低着头等他补线，乖得像一头被牵回圈里的老牛。缝尸人说，这是他这辈子见过最省心的病人。",
            "下雨的夜里，%name% 会独自站在营地边缘淋雨，任凭雨水冲刷身上的盐痂。活人兄弟们说它是在想家，可谁也说不清，一个死人究竟还能想起些什么。",
            "%name% 不会说话，只会偶尔从喉咙里挤出一声含糊的低吼。新来的活人兄弟起初被吓得半死，后来才发现，那只是它在提醒你别挡住它的路。",
            "行军的时候，%name% 总是走在队伍的最后面，替大家扛着最重的那口箱子。它从不抱怨，也从不放慢脚步，就像一头永远不会累倒的驮兽。"
        ],
        skeleton = [
            "%name% 是被导师从一座塌了半边的古墓里唤醒的。它在黑暗中站了几百年，对重见天日似乎并不惊讶，只是默默拍掉肩上的墓土，站进了队列。",
            "营地里的活人兄弟喜欢在 %name% 的头骨上挂斗篷和水壶，它也从不介意，任由他们折腾。直到有一次号角响起，它直接顶着三只水壶冲进了敌阵。",
            "%name% 有个奇怪的习惯：每天黎明时分，它都会面朝东方笔直地站上一会儿，一动不动，像是在等待一场早已结束了几百年的晨操点名。",
            "夜里守营的时候，%name% 是最可靠的哨兵。它从不打瞌睡，也从不抱怨寒冷，只是那副骨头偶尔发出的咔哒声，会把新来的活人吓得跳起来。",
            "盗墓贼们发现，只要在 %name% 面前喊一声古帝国的军令，它就会立刻挺直骨架立正站好。可惜那几句口令太过古老，营地里谁也说不全。",
            "%name% 没有舌头，也没有声带，却总能用骨头的咔哒声表达出一些意思。时间久了，活人兄弟们甚至能分辨出它是在催促，还是在抗议。",
            "每次战斗结束后，%name% 都会仔细地把自己掉落的碎骨捡回来，一块一块交给缝尸人。缝尸人笑着说，它对自己这副骨架爱惜得近乎小气，一块碎渣都舍不得丢。",
            "%name% 对活人的食物毫无兴趣，却会在篝火旁一坐就是一整夜，静静地看着跳动的火苗。没有人知道，那缕魂火是否也能感受到一丝温暖。",
            "营地里的狗起初总冲着 %name% 狂吠，后来发现它从不还手，渐渐就把它当成了一根会走路的骨头。现在，那条狗每天都要叼着它的腿骨磨牙。",
            "%name% 的兵器从来都擦得一尘不染，即使上面的锈迹早已渗进了铁里，再也擦不掉。看来不论过去多少年，军团的规矩都还刻在它的骨头里。"
        ],
        archer = [
            "%name% 每天都要花上一个时辰检查箭矢，把弯掉的箭杆一根根挑出来，再按长短排好。活人弓手们起初嘲笑它多此一举，后来都偷偷学了起来。",
            "营地里的猎户和 %name% 比过一次射靶，输掉了整整一个月的酒钱。从那以后，他再也不在篝火边吹嘘自己当年在林子里的那些光荣事迹了。",
            "%name% 总是挑营地里最高的地方站岗，一站就是一整夜。它那空洞的眼窝一直望着漆黑的远方，总能比任何活人哨兵都更早发现来犯的敌人。",
            "%name% 不需要睡觉，于是活人兄弟们把夜里削箭杆的活全交给了它。第二天早上，营地里总会多出一大捆削得整整齐齐、羽毛也粘好的新箭。",
            "下雨天，%name% 会把弓藏进自己的肋骨间护着，宁可让雨水打湿骨头，也不肯让弓弦受潮。缝尸人说，它对那张弓比对它自己还要上心。",
            "%name% 射箭的时候从不需要屏住呼吸，因为它根本就没有呼吸，手也从来不抖。活人弓手们都很嫉妒这一点，私下里抱怨说，它这根本就是在作弊。",
            "盗墓贼们最喜欢和 %name% 打赌，看它能不能射中远处树枝上的乌鸦。它每次都射中，附近林子里的乌鸦很快就被射光了，这场赌局只好无限期暂停。",
            "%name% 在营地里很少走动，总是独自坐在箭靶旁边，一遍又一遍地擦拭弓臂。活人兄弟们私下猜测，它大概是在怀念生前某片早已消失在荒草里的猎场。",
            "%name% 每次射空一箭，都会歪着头盯着那支箭看上好一会儿，像是不敢相信自己竟然会失手。所幸这样的场面并不多见，大家也就由它去了。",
            "行军途中，%name% 总会在路边捡些合用的木枝和鸟羽，塞进自己的箭囊里。营地里用的弓箭，差不多有一半都出自它那双灵巧的指骨，连伙夫的烧火棍都被它削过。"
        ]
    }
};

// 文本版本：读档时说明版本低于这个值的常驻亡灵会按原来的下标重建一次说明
S.UndeadLoreVersion <- 2;

S.undeadLoreFamily <- function( _bg )
{
    return _bg.m.PaleRanged ? "archer" : _bg.m.PaleSkeleton ? "skeleton" : "zombie";
};

// 取一个存在旗标里的下标；没有时随机一个并存起来（没有角色时只随机，不存）
S.getOrRollUndeadIndex <- function( _flags, _key, _len )
{
    if (_flags != null && _flags.has(_key))
    {
        local i = _flags.getAsInt(_key);
        if (i >= 0 && i < _len)
            return i;
    }
    local i = ::Math.rand(0, _len - 1);
    if (_flags != null)
        _flags.set(_key, i);
    return i;
};

S.undeadLore <- function( _bg )
{
    local family = this.undeadLoreFamily(_bg);
    local formKey = _bg.getID().slice("background.pale_".len());
    local origins = this.UndeadLore.Origins[family];
    local camps = this.UndeadLore.Camp[family];
    local forms = formKey in this.UndeadLore.Forms ? this.UndeadLore.Forms[formKey] : null;
    local flags = null;
    try
    {
        local actor = _bg.getContainer().getActor();
        if (actor != null && !::MSU.isNull(actor))
            flags = actor.getFlags();
    }
    catch (e)
    {
        flags = null;
    }
    local origin = origins[this.getOrRollUndeadIndex(flags, "PaleLoreOrigin", origins.len())];
    local form = forms != null ? forms[this.getOrRollUndeadIndex(flags, "PaleLoreForm", forms.len())] : _bg.m.BackgroundDescription;
    local camp = camps[this.getOrRollUndeadIndex(flags, "PaleLoreCamp", camps.len())];
    if (flags != null)
        flags.set("PaleLoreVer", this.UndeadLoreVersion);
    return origin + form + "\n\n" + camp;
};

// 旧存档：说明版本过旧（或没有身世旗标）的常驻亡灵，读档时重写一次说明；已有的身世下标保留
S.refreshUndeadLore <- function()
{
    foreach (bro in ::World.getPlayerRoster().getAll())
    {
        if (!this.isUndead(bro) || bro.getFlags().getAsInt("PaleLoreVer") >= this.UndeadLoreVersion)
            continue;
        local bg = bro.getBackground();
        if (bg == null || bg.getID().find("background.pale_") != 0 || bg.getID().find("background.pale_sb_") == 0 || bg.getID() == this.Chief)
            continue;
        try { bg.buildDescription(true); } catch (e) { ::logError("[PaleSovereign] 重写常驻亡灵说明: " + e); }
    }
};
