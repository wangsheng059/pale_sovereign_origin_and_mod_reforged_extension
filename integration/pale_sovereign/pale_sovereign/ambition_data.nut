::PaleSovereign.AmbitionData <- {
    night_walker = {
        Name = "长夜行者",
        Task = "在夜色掩护下赢得 1 场战斗，让活人见识导师在黑夜中的真正手段。",
        Story = "营火早在半夜便已熄灭，只余下几缕呛人的青烟在冷风里打转，但战团里再没人抱怨摸黑行军。这场夜战结束时，溃逃的敌人连你们的旗号都没能看清，只听见伸手不见五指的林地间传来枯骨摩擦与重锤砸碎甲片的闷响。盗墓贼们蹲在泥泞的土坡上，借着微弱的星光熟练地摸尸分赃，其中一人往地上啐了一口带血的浓痰：“大白天列阵对砍，那是给身披彩衣的骑士老爷准备的体面活。咱们这行，天越黑，死人越听话，干活也越顺手。”导师站在坡顶，用一块发黑的麻布缓缓擦拭法杖上凝结的夜露与血渍。远处林梢吹过一阵刺骨的寒风，杖头幽绿的魂火却没有丝毫摇曳，反而在浓重的夜色中燃烧得比白昼更加明亮。活人惧怕黑暗，而黑暗恰恰是亡灵法师最忠实的披风。",
        Abandon = "队伍决定不再刻意挑拣夜战时机。毕竟只要给够价钱，太阳底下一样能收尸。",
        Renown = 150,
        Reward = "获得守夜人的骨灯。冠军誓约另得 1 枚古代魂玉，天灾誓约补充 10 点防腐尸骸，尚未立誓则获得 400 克朗与 2 点防腐尸骸。活人兄弟的心情会变好。",
        Icon = "skills/pale_sb_night_walker.png",
    },
    pale_banner = {
        Name = "苍白之旗",
        Task = "声望达到 1000，或攻克一处古代遗址，竖起属于亡灵主宰的战旗。",
        Story = "雇佣兵常用的彩色亚麻军旗在腐气、泥浆和阴雨里撑不了几天，还没见过几场硬仗就会烂成一团发臭的破布。导师没有去城镇的裁缝铺花冤枉钱，而是亲手取来从古老墓穴中剥下的灰白裹尸布，用浸透了粗盐、松脂与骨灰的麻线重新缝合，再用生锈的铁钉死死铆在一段沉重的黑木旗杆上。当这面毫无纹章、却透着森冷死气的苍白战旗在营地中央升起时，正在擦拭武器的活人兄弟们下意识地压低了交谈声，连平日里最爱吹牛的逃兵都闭上了嘴。而在营火照不到的阴影边缘，那些游荡的枯骨与行尸齐刷刷转过空洞的眼眶，朝旗杆的方向迈近了半步。风卷起苍白的布角，发出干涩的猎猎声响。从今往后，无论活人还是死者，在战场上都认得这面旗。",
        Abandon = "旗帜只是招惹猎巫人和巡逻队的靶子。战团决定先收起这个念头，低调行事。",
        Renown = 200,
        Reward = "获得苍白战旗。活人兄弟的心情会变好。",
        Icon = "skills/pale_banner.png",
    },
    first_soul_theft = {
        Name = "第一次窃魂",
        Task = "用【缚魂锁链】标记一名合格的敌方精锐，在胜后将其力量注入出战冠军。",
        Story = "战斗的尘埃尚未落定，那条漆黑的缚魂锁链正死死绞在倒毙精锐的喉骨上，冰冷的铁环此刻却隐隐发烫，在死寂的战场上发出细碎而急促的蜂鸣。导师走上前，一脚踩住敌尸残破的胸甲，亲手揭开身旁沉重的棺盖。随着低沉晦涩的咒文出口，锁链瞬间绷得笔直，将一缕挣扎嘶鸣的灰青色残魂生生拽出躯壳，沿着铁链灌入棺中冠军空荡的胸腔。厚重的橡木棺椁剧烈震颤了三下，铜箍崩得咔咔作响，四周的空气骤然降温，随即归于死寂。片刻后，一只披着残甲的枯手猛地搭上棺沿。当这名冠军再次拄着兵器站起身时，它的步伐比从前沉稳得多，握持武器的姿势也透出一股森然的杀意。旧主人的技艺与执念已经彻底易主，化作了它刻入骨髓的杀戮本能。",
        Abandon = "强行拘押强敌的魂魄太过凶险。导师收起了锁链，打算等手头更宽裕时再做尝试。",
        Renown = 250,
        Reward = "返还 1 条缚魂锁链，并在地图上标出一处古代遗址。此后黑铁的私活只收 250 克朗。",
        Icon = "skills/pale_chain.png",
    },
    immortal_guard = {
        Name = "不朽的王座护卫",
        Task = "让同一名出战冠军完成 2 次【吞魂】，或完成一次【承誓】继承精锐的装备和具名武器。",
        Story = "营地里早就没人敢把这具披甲枯骨当成临时复活的亡灵。它静静矗立在导师帐篷外的阴影里，甲胄缝隙间渗出的不再是稀薄的魂雾，而是几乎凝成实质的森冷寒气，连脚下的荒草都被冻得发脆。数道强敌生前的执念与战意在它体内彼此撕咬、吞噬，最终在导师的意志压制下归于臣服，锻造出一具不知疲倦、也不知恐惧的杀戮机器。每当有外人靠近营地，它只需微微偏过头颅，眼眶中幽绿的魂火便会骤然暴涨，压得活人喘不过气。就连跟了战团许久的盗墓贼们，路过它身旁时也会下意识地绕开两步、压低脚步声——他们实在分不清，那副冰冷头盔下的眼火里，究竟还剩几分生前的理智，又藏着多少主人的残酷意志。它已真正配得上王座护卫之名。",
        Abandon = "把所有筹码押在一具躯壳上风险太高。导师决定放缓对这名护卫的锻造。",
        Renown = 400,
        Reward = "获得 1 枚古代魂玉和 1 条缚魂锁链。出战冠军每场战斗挡下首次受到的攻击，棺椁的自然恢复翻倍，贴身护卫使导师近战防御、远程防御各 +5。",
        Icon = "skills/pale_amb_guard.png",
    },
    laden_cart = {
        Name = "满载的尸车",
        Task = "将【防腐尸骸】储备积攒至 25 点以上，并在战斗中投掷【尸弹】累计 5 次。",
        Story = "战团的补给马车早就彻底变了模样。厚重的油布下面塞得满满当当，既不是发霉的麦袋，也不是廉价的麦酒桶，而是一排排用粗盐、松脂、石灰和麻绳捆扎得整整齐齐的防腐尸骸。车轮碾过泥泞的土路，车轴发出不堪重负的吱呀声，空气里始终飘着一股刺鼻的咸腥与草药味。活人兄弟们起初还捏着鼻子抱怨，直到他们在战场上亲眼看见一具沉重的尸体划过半空，越过盾墙狠狠砸翻了对面的弓手，紧接着又在敌阵后方扭曲着爬起来挥舞烂手。那场仗打完后，便再没人嫌弃车厢里的气味了。如今连最挑剔的逃兵也摸索出了码放尸体的窍门——只需调整一下捆扎与叠放的角度，原本拥挤的车厢里立刻就能腾出更多空间，足以再多塞上十来具成色上佳的好货。",
        Abandon = "拖着一车死人赶路实在太慢。战团决定先清理掉多余的负担，轻装上阵。",
        Renown = 200,
        Reward = "防腐尸骸上限 +10，并补充 6 点尸骸。物品栏 +9 格，尸弹的疲劳消耗从 20 降为 16。",
        Icon = "skills/pale_amb_cart.png",
    },
    ranks_of_dead = {
        Name = "死者的队列",
        Task = "永久编制中同时拥有至少 4 名常驻亡灵，并率领它们赢得 3 场胜利。",
        Story = "行军时不再需要督战官声嘶力竭地喊号子，也不必像寻常佣兵团那样，每天对着账本精打细算高昂的军饷、医药与口粮。四具以上的常驻亡灵排成沉默而齐整的队列走在队伍最前方，干枯的骨节在寒风里咔嗒作响，行尸灰败的烂肉冻得微微发硬，却没有一个会喊累或掉队。三场硬仗打下来，活人兄弟们早已习惯了与这些死物并肩作战：死者顶在最前面接下最致命的劈砍与箭雨，活人则从容地绕到侧翼收割和包抄。天黑扎营后，活人围着篝火喝汤，导师却借着油灯微弱的光亮，在缝合台前反复改进了接骨与防腐的手法。如今，同样一份防腐尸骸材料，经过更精细的裁剪与拼补，已经能修补更多的断骨与裂口，足以让这支沉默的死者队列永远保持完整。",
        Abandon = "维持一支庞大的常驻尸群耗费了太多精力。导师决定暂时缩减编制，多依靠战场上临时复活的亡灵。",
        Renown = 350,
        Reward = "常驻亡灵每日修补量提高至 35%，征召消耗降为 2 点防腐尸骸。另补充 4 点防腐尸骸和 10 点工具。",
        Icon = "skills/pale_amb_ranks.png",
    },
    forbidden_glimpse = {
        Name = "禁忌的初窥",
        Task = "完成专属法杖蜕变后，攻克【狩猎场】、【哥布林王城】或【黑色巨石】中的任意一座传奇地点，以验证超越凡胎的猜想。",
        Story = "激战过后，废墟间残留的古老魔力仍在夜风中缓缓沸腾。导师独自走过尚未冷透的尸骸，指尖轻轻拂过蜕变后的法杖，一股前所未有的冰冷战栗顺着掌心直冲脑海。这一战让你彻底看清了凡人躯壳的局限，却也让你第一次触摸到了生死界限之外的门槛。借着微弱的魂火，你在营地的羊皮卷上匆匆记下残缺的感悟：单靠一处遗迹的伟力，尚不足以彻底挣脱生老病死的枷锁。若想拼凑出那道足以重塑躯壳的禁忌仪轨，还须集齐三股截然不同的极境本源——荒野狩猎场里古老神兽的血肉残魂、哥布林王城深处阴毒诡谲的萨满巫术，以及黑色巨石下沉睡千年的古帝国幽冥死寂。三者缺一不可。你吹灭油灯，望向地图上尚未踏足的漆黑阴影，这具凡胎的尽头，已不再遥远。",
        Abandon = "贸然窥探传奇遗迹深处的禁忌太过凶险。导师收起手札，决定先稳住眼前的局面。",
        Renown = 450,
        Reward = "获得苍白印戒，地图上标出尚未攻克的飞升仪式地点。冠军誓约另得 2 条缚魂锁链与 1 枚古代魂玉；天灾誓约补充 8 点防腐尸骸，每场最多可部署 16 人。",
        Icon = "skills/pale_amb_glimpse.png",
    },
    castle_taken = {
        Name = "城堡易主",
        Task = "用攻城攻下一座城堡（村庄、城镇和南方城邦不算），让领主的高墙改换亡者的旗帜。",
        Story = "城堡的吊桥是在三更时分落下的。守军原以为高墙与箭塔足以挡住一群死物，却没料到骷髅会顶着滚油攀上城垛，行尸会拿自己的身子填平护城河。天亮时，领主的纹章旗已被扯下来，塞进马厩当了垫草；大厅长桌上还摆着没吃完的烤鹅，椅子却全都朝门口翻倒。盗墓贼们撬开库房和地窖，一边清点银盘与酒桶，一边压低嗓子争论该先搬哪一样。活人兄弟站在城头，望着脚下这片曾经要他们脱帽行礼的领地，好一阵子没人开口。有个逃兵摸着城垛上被箭镞凿出的新痕，喃喃说这辈子头一回从里头看这堵墙。导师缓步登上领主的高座，把法杖横放在扶手上，魂火映亮了墙上一排历代领主的画像。礼拜堂的钟楼底下，几具骷髅正把战死的骑士一具具抬进地窖，等候来日重新披甲。从今夜起，诸侯们终于明白，亡者也能守城。",
        Abandon = "城墙太高，守军太多，营里的尸骸也填不平护城河。导师决定先放下攻打城堡的念头，等亡者的队列再壮大些。",
        Renown = 350,
        Reward = "获得 600 克朗。此后每座由你统治或屠城的城堡，防腐尸骸上限再 +20。冠军誓约另得 1 枚古代魂玉，天灾誓约补充 15 点防腐尸骸，尚未立誓则补充 5 点防腐尸骸。活人兄弟的心情会变好。",
        Icon = "skills/pale_amb_castle.png",
    },
};
