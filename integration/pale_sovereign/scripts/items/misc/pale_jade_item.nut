this.pale_jade_item <- ::inherit("scripts/items/item", {
    m = {},
    function create()
    {
        this.item.create();
        this.m.ID = "misc.pale_jade";
        this.m.Name = "古代魂玉";
        this.m.Description = "一块封存着古老战魂的阴冷碧石，触手如冰。\n\n用法：放在仓库里即可，点大地图顶栏名册按钮左侧的“亡灵营地”打开账簿，在主页选对应选项。\n· 晋升尸妖王（冠军路线）：荒坟守卫与导师并肩打赢 10 场后，用 3 枚晋升。\n· 常驻亡灵升阶：每次 1 枚，在“常驻亡灵升阶”里选。\n· 魂玉铭刻（冠军路线）：1 枚刻一条冠军词条，最多 3 条（飞升后 4 条）。\n· 灵阶突破（冠军路线）：玉髓重铸 2 枚（生命 +20、伤害 +10%、行动点 +1，最多 5 次）；不朽玉壳 3 枚。\n· 魂玉统领（天灾路线）：3 枚册封一名 7 级以上常驻亡灵，最多 2 名（飞升后 4 名），切换光环 1 枚。\n· 锁魂者破限（天灾路线）：补魂 1 枚，玉魂不灭 2 枚。\n· 古堡魂炉：魂玉洗骨、名器熔铸、棺魂传承、术法淬玉。\n· 阵亡回收：8 级以上活人战死后，5 点防腐尸骸 + 1 枚魂玉（或 1 条锁链）转为中阶常驻亡灵。\n\n来源：击杀敌方冠军（80%）、勘察遗址、通关传奇地点（2 枚）、冠军注魂吞魂 / 承誓（50%）、天灾采集精锐亡灵尸体（50%）、炼化（之后导师虚弱 2 天）、古堡与墓园偶尔产出、野心。";
        this.m.Icon = "pale/jade.png";
        this.m.ItemType = ::Const.Items.ItemType.Misc;
        this.m.Value = 400;
    }

    // 1.6.21 出售价固定 400
    function getSellPrice()
    {
        return 400;
    }
});
